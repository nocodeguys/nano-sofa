# Copy to .env next to docker-compose.yml. Never commit .env.

# Required to open the Katalog panel (/admin) in any Docker deployment.
# Any long random string; paste the same value into the panel when asked.
ADMIN_TOKEN=

# Optional. Fine-grained GitHub personal access token with
# "Contents: Read and write" on ONE repository (the one below). When set,
# every catalogue save is committed to that repo, CI rebuilds the image and
# Watchtower rolls it out to every instance. Without it, edits stay on this
# instance only and are protected from being overwritten by image updates.
CATALOG_GIT_TOKEN=
CATALOG_GIT_REPO=nocodeguys/nano-sofa
CATALOG_GIT_BRANCH=main
# Shown as the commit author, e.g. "Katalog bot <katalog@treetale.eu>"
CATALOG_GIT_AUTHOR=
